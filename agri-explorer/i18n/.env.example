# Copy file này thành .env.local rồi điền giá trị thật — .env.local đã được
# .gitignore loại trừ, KHÔNG BAO GIỜ commit file chứa credential thật.
#
# Chỉ dùng bởi `scripts/seed-content.mts` và `scripts/sync-content.mts`
# (chạy qua `npm run content:seed` / `npm run content:sync`). KHÔNG dùng
# tiền tố NEXT_PUBLIC_ — các biến này không bao giờ được đọc bởi code app
# Next.js, chỉ đọc trong script Node độc lập.

# Base URL của AgriExplorerApi (.NET), ví dụ http://localhost:5080
AGRI_API_URL=

# Tài khoản admin để login lấy JWT — CHỈ cần khi chạy content:seed (ghi dữ liệu).
# Tạo qua SeedAdmin:Username/Password trong appsettings.json của AgriExplorerApi.
AGRI_API_USERNAME=
AGRI_API_PASSWORD=
