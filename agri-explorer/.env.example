# Copy file này thành .env.local rồi điền giá trị thật — .env.local đã được
# .gitignore loại trừ, KHÔNG BAO GIỜ commit file chứa key thật.
#
# Lấy 2 giá trị dưới đây tại: Supabase Dashboard → Project Settings → API.
#
# Chỉ dùng bởi `scripts/seed-content.mts` và `scripts/sync-content.mts`
# (chạy qua `npm run content:seed` / `npm run content:sync`). KHÔNG dùng
# tiền tố NEXT_PUBLIC_ — 2 biến này không bao giờ được đọc bởi code app
# Next.js, chỉ đọc trong script Node độc lập.

# URL project, dạng https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key — CÓ QUYỀN GHI VÀ BYPASS RLS. Tuyệt đối không lộ ra
# client, không commit, không dán vào chat/log công khai.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Mục 7 — Admin Dashboard, gọi sang AgriExplorerApi (.NET 8 + MSSQL)
# Dùng NEXT_PUBLIC_ vì gọi trực tiếp từ browser (admin login bằng JWT của
# chính user, không qua service-role) — xem lib/api/client.ts.
NEXT_PUBLIC_API_URL=http://localhost:5000
